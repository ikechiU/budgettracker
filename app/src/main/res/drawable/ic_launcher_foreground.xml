<?xml version="1.0" encoding="utf-8"?>
<!--
  Safe zone: centre 72×72 of the 108×108 canvas (18dp inset each side).
  Design: three ascending white bars + connecting trend line + arrowhead.
  Bars (x=26-84, baseline y=80):
    Bar1 12dp tall  (26-40, y 68-80)
    Bar2 26dp tall  (48-62, y 54-80)
    Bar3 36dp tall  (70-84, y 44-80)
  Trend line connects bar-top centres: (33,68)→(55,54)→(77,44)
  Arrow tip sits above bar 3 at (77,32), base meets bar top at y=44.
  Baseline rect (22-86, y 80-83).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Bar 1 – short, rounded top -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M26,80 V70 Q26,68 28,68 H38 Q40,68 40,70 V80 Z"/>

  <!-- Bar 2 – medium, rounded top -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M48,80 V56 Q48,54 50,54 H60 Q62,54 62,56 V80 Z"/>

  <!-- Bar 3 – tall, rounded top -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M70,80 V46 Q70,44 72,44 H82 Q84,44 84,46 V80 Z"/>

  <!-- Baseline -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M22,80 H86 V83 H22 Z"/>

  <!-- Trend line connecting bar-top centres -->
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="3.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M33,68 L55,54 L77,44"/>

  <!-- Arrowhead – tip at (77,31), base flush with bar-3 top (y=44) -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M77,31 L70,44 L84,44 Z"/>

</vector>
